# Lesedi AI Agent — environment variables
# Copy this to .env and fill in your values. Never commit .env.

# --- Provider selection ---
# 'stub'        No real AI call. Safe for local dev and CI.
# 'azure'       Azure AI Foundry (Claude Sonnet 3.5 via Azure)
# 'databricks'  Databricks Model Serving (stub — fill in endpoint below)
PROVIDER=stub

# --- Azure AI Foundry ---
# Found in: Azure Portal → AI Foundry resource → Keys and Endpoint
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
AZURE_AI_KEY=<your-azure-api-key>
LESEDI_MODEL=claude-sonnet-4-5
MAX_TOKENS=600

# --- Databricks (future) ---
# DATABRICKS_ENDPOINT=https://<workspace>.azuredatabricks.net/serving-endpoints/<name>/invocations
# DATABRICKS_TOKEN=<your-databricks-pat>

# --- Backend port (must match Pula backend) ---
PORT=4000
