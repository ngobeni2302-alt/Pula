# Copy this to .env and fill in your values. Never commit .env.

# ── Store selection ────────────────────────────────────────────────────────
# true  → use backend/data.json (demo / offline mode)
# false → use PostgreSQL (requires DATABASE_URL)
USE_JSON_STORE=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Local Docker:  postgres://pula:pula_dev@localhost:5432/pula?sslmode=disable
# Azure:         postgres://<user>:<pass>@<host>.postgres.database.azure.com/pula?sslmode=require
DATABASE_URL=postgres://pula:pula_dev@localhost:5432/pula?sslmode=disable

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Azure AI (Phase 2) ─────────────────────────────────────────────────────
# AZURE_CLIENT_ID=
# AZURE_AI_ENDPOINT=
# AZURE_AI_KEY=
# LESEDI_MODEL=claude-sonnet-4-5
# LESEDI_DAILY_CALL_CAP=200
# MAX_TOKENS=600
# PROVIDER=stub

# Lesedi Core: separate secure workflow (server-side only)
# CORE_DATA_FILE=/absolute/path/to/private/core.json
LESEDI_CORE_MODE=mock
# LESEDI_CORE_URL=https://your-lesedi-api.vercel.app/api/evaluate
# LESEDI_CORE_KEY=
PHONICS_AUDIO_VERIFIED=false
# PULA_DEMO_PASSWORD=
# HOST=127.0.0.1
# TRUST_PROXY_HOPS=1
# CORE_RETENTION_DAYS=90
