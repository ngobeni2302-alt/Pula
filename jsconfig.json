{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "*": ["frontend/node_modules/*", "*"]
    }
  },
  "include": [
    "frontend/src/**/*",
    "teacher/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "frontend/dist",
    "backend/node_modules"
  ]
}
